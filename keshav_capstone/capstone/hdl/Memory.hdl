// Hack memory map: RAM16K, Screen, and Keyboard.
CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];
    PARTS:
    DMux4Way(in=load, sel=address[13..14], a=ramLoad, b=screenLoad, c=unusedLoad, d=unusedLoad2);
    RAM16K(in=in, load=ramLoad, address=address[0..13], out=ramOut);
    Screen(in=in, load=screenLoad, address=address[0..12], out=screenOut);
    Keyboard(out=keyboardOut);
    Mux4Way16(a=ramOut, b=screenOut, c=keyboardOut, d=false, sel=address[13..14], out=out);
}
